// VeganSaathi — Firestore Security Rules
// Phase 3 foundation. See docs/FIREBASE_SECURITY.md for the full access model
// explanation and docs/DATABASE_SCHEMA.md for field definitions.
//
// Access model summary:
//   Visitor (no account)   — read published places and reviews only.
//   Authenticated user     — create their own submissions/reviews/reports/saved
//                             places; read/update only their own user doc; can
//                             never set role="admin" or flip a place's
//                             status/verificationStatus themselves.
//   Admin (role=="admin"   — full moderation: approve/reject/re-verify places,
//   on their own user doc)   resolve/dismiss reports, delete reviews.
//
// No blanket `allow read, write: if true;` anywhere in this file.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- helpers ----------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admin status is derived from the requester's OWN users/{uid} document,
    // never from a client-supplied claim, so it can't be spoofed by sending a
    // fake "role" field in the request payload.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isValidDietPreference(value) {
      return value in ["vegan", "vegetarian", "eggetarian", "jain", "unspecified"];
    }

    function isValidDietTags(tags) {
      return tags is list
        && tags.size() > 0
        && tags.hasOnly(["vegan", "vegetarian", "eggetarian", "jain"]);
    }

    function isValidPlaceType(value) {
      return value in ["restaurant", "mess", "canteen", "cafe", "dhaba", "bakery", "dessert", "shop", "other"];
    }

    function isValidPriceRange(value) {
      return value in ["budget", "moderate", "premium", "Price not listed"];
    }

    // Global coordinate validation: accepts any well-formed lat/lon pair.
    // VeganSaathi is not restricted to a single region; see COORD_BOUNDS in
    // frontend/js/places-service.js for the matching client-side constant.
    // NOTE: these rules have not yet been deployed to the live project.
    // Deployment is an explicitly authorized step scheduled for Phase 4.
    function isValidCoordinates(lat, lon) {
      return (lat is int || lat is float)
        && (lon is int || lon is float)
        && lat >= -90 && lat <= 90
        && lon >= -180 && lon <= 180;
    }

    function isWithinOptionalLength(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidPlacePayload(data) {
      return isValidPlaceType(data.placeType)
        && isValidDietTags(data.dietTags)
        && isValidPriceRange(data.priceRange)
        && isValidCoordinates(data.latitude, data.longitude)
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 100
        && data.address is string
        && data.address.size() > 0
        && data.address.size() <= 300
        && (data.verificationStatus != "verified" || data.lastVerifiedAt is timestamp);
    }

    // ---------------- users ----------------
    // Document ID == Firebase Auth uid.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.role == "user"
        && isValidDietPreference(request.resource.data.dietPreference);

      // A user may update their own profile, but only permitted fields (name, dietPreference, updatedAt),
      // role and email remain immutable, and dietPreference is re-validated on every update.
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["name", "dietPreference", "updatedAt"])
        && isValidDietPreference(request.resource.data.dietPreference);

      // No client-side account deletion in the MVP — if this is ever needed,
      // it should go through a trusted server-side flow (e.g. a Cloud
      // Function), not a direct Firestore delete.
      allow delete: if false;
    }

    // ---------------- places ----------------
    match /places/{placeId} {
      // Visitors and other users may read a place once it's published.
      // The submitter may also read their own not-yet-published submission
      // (so they can see its pending status), and admins can read everything.
      allow read: if (resource.data.status == "published")
        || isAdmin()
        || (isSignedIn() && resource.data.submittedBy == request.auth.uid);

      // Admins can create places directly (e.g. from approved import batches),
      // subject to valid schema and verification payload requirements.
      // A new community submission always starts pending/unverified and source="community".
      // A user cannot publish, pre-verify, or spoof fieldwork attribution.
      allow create: if (isAdmin() && isValidPlacePayload(request.resource.data))
        || (
          isSignedIn()
          && request.resource.data.submittedBy == request.auth.uid
          && request.resource.data.source == "community"
          && request.resource.data.status == "pending"
          && request.resource.data.verificationStatus == "unverified"
          && isValidPlacePayload(request.resource.data)
        );

      // Admins can change anything (approve, reject, edit, re-verify),
      // but payload must remain valid (cannot inject malformed data or fake verification).
      // The original submitter may still edit their OWN submission while it
      // is still pending, but cannot use that edit to publish, verify,
      // reassign ownership, change creation timestamp, or flip source to fieldwork.
      allow update: if (isAdmin() && isValidPlacePayload(request.resource.data))
        || (
          isSignedIn()
          && resource.data.submittedBy == request.auth.uid
          && resource.data.status == "pending"
          && request.resource.data.status == "pending"
          && request.resource.data.verificationStatus == "unverified"
          && request.resource.data.source == "community"
          && request.resource.data.submittedBy == resource.data.submittedBy
          && request.resource.data.createdAt == resource.data.createdAt
          && isValidPlacePayload(request.resource.data)
        );

      allow delete: if isAdmin();
    }

    // ---------------- reviews ----------------
    match /reviews/{reviewId} {
      // Reviews are public read. Public read is safe because the document schema
      // strictly allows only public review fields (no private email or account data).
      allow read: if true;

      // Review creation: strict allowlist, bounded comment, published place requirement.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(["placeId", "userId", "authorName", "rating", "comment", "createdAt"])
        && request.resource.data.placeId is string
        && request.resource.data.placeId.size() > 0
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 100
        && isWithinOptionalLength(request.resource.data, "comment", 500)
        && exists(/databases/$(database)/documents/places/$(request.resource.data.placeId))
        && get(/databases/$(database)/documents/places/$(request.resource.data.placeId)).data.status == "published";

      // Reviews aren't editable in the MVP — remove and repost instead.
      allow update: if false;

      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ---------------- reports ----------------
    match /reports/{reportId} {
      // Only the reporter and admins can see a given report — reports can
      // contain candid detail about a real vendor, so this stays narrow.
      allow read: if isAdmin() || (isSignedIn() && resource.data.reporterId == request.auth.uid);

      // Report creation: strict allowlist, bounded description, valid reason.
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys().hasOnly(["placeId", "reporterId", "reason", "status", "description", "createdAt"])
        && request.resource.data.placeId is string
        && request.resource.data.placeId.size() > 0
        && request.resource.data.status == "pending"
        && request.resource.data.reason in [
             "place-closed", "wrong-diet-info", "wrong-address",
             "temporarily-unavailable", "outdated", "other"
           ]
        && isWithinOptionalLength(request.resource.data, "description", 500);

      // Only an admin resolves or dismisses a report.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["status", "resolvedAt", "adminNote", "updatedAt"])
        && request.resource.data.status in ["resolved", "dismissed"];

      allow delete: if false;
    }

    // ---------------- savedPlaces ----------------
    // Document ID == "{uid}_{placeId}" (see docs/DATABASE_SCHEMA.md).
    match /savedPlaces/{saveId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(["userId", "placeId", "createdAt"])
        && saveId == (request.auth.uid + "_" + request.resource.data.placeId);

      // Saved-place docs are only ever created or removed, never edited.
      allow update: if false;

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ---------------- editSuggestions (disabled until a strict schema and workflow are approved) ----------------
    match /editSuggestions/{suggestionId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.suggestedBy == request.auth.uid);
      // No client writes are permitted while this future workflow is unimplemented.
      allow create, update, delete: if false;
    }

    // ---------------- placeCandidates (Place Intelligence staging) ----------------
    match /placeCandidates/{candidateId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && !candidateId.matches('^cand_synthetic_fixture_.*$')
        && request.resource.data.candidate_id == candidateId
        && request.resource.data.import_status == "staged"
        && request.resource.data.source_id is string
        && request.resource.data.source_id.size() > 0
        && request.resource.data.source_dataset_version is string
        && request.resource.data.source_dataset_version.size() > 0
        && !request.resource.data.keys().hasAny([
          "is_synthetic_fixture", "synthetic_fixture_id", "synthetic_dataset_version", "dataset_origin"
        ]);
      allow update: if isAdmin()
        && resource.data.import_status == "staged"
        && request.resource.data.import_status in ["approved", "rejected"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "import_status", "approvedPlaceId", "approvedBy", "approvedAt",
          "rejectionNotes", "rejectedBy", "rejectedAt"
        ]);
      allow delete: if false;
    }

    // ---------------- importBatches (Audit manifest records) ----------------
    match /importBatches/{batchId} {
      allow read, write: if isAdmin();
    }

    // ---------------- placePhotos (Rights-cleared photo pipeline) ----------------
    match /placePhotos/{photoId} {
      allow read: if (resource.data.approval_status == "approved"
          && exists(/databases/$(database)/documents/places/$(resource.data.place_id))
          && get(/databases/$(database)/documents/places/$(resource.data.place_id)).data.status == "published")
        || isAdmin()
        || (isSignedIn() && resource.data.submitter_uid == request.auth.uid);

      // A rights claim and an attributable creator/rights holder are required
      // before a photo can enter the moderation queue. Do not accept arbitrary
      // metadata that could later be mistaken for verified permission.
      allow create: if isSignedIn()
        && request.resource.data.submitter_uid == request.auth.uid
        && request.resource.data.approval_status == "pending"
        && request.resource.data.place_id is string
        && request.resource.data.place_id.size() > 0
        && exists(/databases/$(database)/documents/places/$(request.resource.data.place_id))
        && get(/databases/$(database)/documents/places/$(request.resource.data.place_id)).data.status == "published"
        && request.resource.data.photo_category in ["storefront", "interior", "food", "menu", "logo"]
        && request.resource.data.keys().hasOnly([
          "place_id", "submitter_uid", "submitter_name", "photo_category", "approval_status",
          "submission_type", "is_original_work", "has_permission_to_publish", "rights_holder",
          "photographer_name", "temp_url", "cloudinary_url", "cloudinary_asset_id",
          "attribution_required", "attribution_text", "licence", "upload_timestamp", "public_alt_text"
        ])
        && ((request.resource.data.is_original_work == true)
          || (request.resource.data.has_permission_to_publish == true))
        && ((request.resource.data.rights_holder is string && request.resource.data.rights_holder.size() > 0)
          || (request.resource.data.photographer_name is string && request.resource.data.photographer_name.size() > 0))
        && (!("attribution_required" in request.resource.data)
          || request.resource.data.attribution_required != true
          || (request.resource.data.attribution_text is string && request.resource.data.attribution_text.size() > 0));

      allow update: if isAdmin()
        && resource.data.approval_status == "pending"
        && exists(/databases/$(database)/documents/places/$(resource.data.place_id))
        && get(/databases/$(database)/documents/places/$(resource.data.place_id)).data.status == "published"
        && request.resource.data.approval_status in ["approved", "rejected"]
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["approval_status", "approving_admin_uid", "approval_timestamp", "rejection_reason"]);

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.submitter_uid == request.auth.uid && resource.data.approval_status == "pending");
    }

    // ---------------- verificationHistory (Audit trail for verification decisions) ----------------
    match /verificationHistory/{historyId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // ---------------- businessClaims (disabled until identity-proof and status schemas are approved) ----------------
    match /businessClaims/{claimId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      // A claim is not business ownership proof; disable writes until reviewed controls exist.
      allow create, update, delete: if false;
    }

    // Deny anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
