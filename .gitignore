__pycache__/
*.py[cod]
.venv/
venv/

# Test-runner caches (generated locally, never shipped)
.pytest_cache/

# Binary archives — not source code
*.zip

# Oversized test fixtures (generated locally, not needed in repo)
tests/fixtures/oversized_dummy.jpg

# Large data acquisition / raw external datasets (never commit bulk licensed dumps)
data/raw/
*.pbf
*.parquet
*.ndjson
